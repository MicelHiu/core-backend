generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum users_role {
  admin
  user
}

enum rooms_type {
  PC
  PS
}

enum booking_status {
  confirmed
  ongoing
  canceled
  completed
}

model users {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name   String
  nickname    String
  email       String      @unique
  contact     String
  password    String
  role        users_role
  points      Int
  created_at  DateTime    @default(now()) @db.Timestamp(6)

  carts           carts[]
  bookings        bookings[]
  visitors        visitors[]
  activity_logs   activity_logs[]
}

model rooms {
  id          String      @id
  name        String      
  description String     
  price       Decimal     @db.Decimal(12, 2)
  image       String      
  type        rooms_type
  stock       Int

  carts       carts[]
  bookings    bookings[]
}

model discounts {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String 
  value       Decimal     @db.Decimal(12, 2)
  valid_from  DateTime
  valid_until DateTime
  created_at  DateTime    @default(now()) @db.Timestamp(6)
  is_active   Boolean     

  carts       carts[]
  bookings    bookings[]
}

model carts {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String      @db.Uuid
  room_id         String
  quantity        Int
  discount_id     String?      @db.Uuid
  discount_value  Decimal?     @db.Decimal(12, 2)
  date_play       DateTime     @db.Date
  time_start      DateTime     @db.Time
  time_end        DateTime     @db.Time
  total_price     Decimal      @db.Decimal(12, 2)
  created_at      DateTime     @default(now()) @db.Timestamp(6)

  users           users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  rooms           rooms        @relation(fields: [room_id], references: [id], onDelete: Restrict)
  discounts       discounts?    @relation(fields: [discount_id], references: [id], onDelete: Restrict)
}

model bookings {
  code            String        @id
  user_id         String        @db.Uuid
  room_id         String        
  guest_name      String
  guest_contact   String
  time_start      DateTime      @db.Time
  time_end        DateTime      @db.Time
  date_play       DateTime      @db.Date
  unit_price      Decimal       @db.Decimal(12, 2)
  discount_id     String?       @db.Uuid
  discount_value  Decimal?      @db.Decimal(12, 2)
  quantity        Int
  total_price     Decimal       @db.Decimal(12, 2)
  status          booking_status
  created_at      DateTime      @default(now()) @db.Timestamp(6)

  users           users         @relation(fields: [user_id], references: [id])
  rooms           rooms         @relation(fields: [room_id], references: [id])
  discounts       discounts?    @relation(fields: [discount_id], references: [id])
  visitors        visitors[]
  activity_logs   activity_logs[]
}

model visitors {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_code  String         
  user_id       String      @db.Uuid
  guest_name    String      
  checked_in    DateTime
  created_at    DateTime    @default(now()) @db.Timestamp(6)

  bookings      bookings    @relation(fields: [booking_code], references: [code])
  users         users        @relation(fields: [user_id], references: [id], onDelete: Restrict)
}

model activity_logs {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_code  String
  admin_id      String          @db.Uuid
  status        booking_status
  note          String?
  created_at    DateTime        @default(now()) @db.Timestamp(6)

  bookings      bookings @relation(fields: [booking_code], references: [code])
  users         users    @relation(fields: [admin_id], references: [id], onDelete: Restrict)
}

